generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Sucursal {
  id           Int          @id @default(autoincrement())
  telefono     String
  direccion    String
  codigoPostal String
  horarios     String

  // Para relacionar Sucursal y Producto
  inventarios  Inventario[]

  // Para relacionar Sucursal y TipoEmpleado
  tiposEmpleado SucursalTipoEmpleado[]

  // Para relacionar Sucursal y Gasto
  gastos        Gasto[]

  // Para relacionar Sucursal y Pedido
  pedidos       Pedido[]

  // Usuarios (uno por rol) que pertenecen a esta sucursal
  usuarios      Usuario[]

  // Para relacionar Sucursal y Mesa
  mesas         Mesa[]
}

model Producto {
  idProducto    Int          @id @default(autoincrement())
  nombre        String
  tipoProducto  String
  descripcion   String?
  precio        Float
  proveedor     String
  stockMinimo   Int

  // Para relacionar Sucursal y Producto
  inventarios   Inventario[]

  // Para relacionar Pedido y Producto
  itemsProducto ItemProducto[]
}

// La relation entre Sucursal y Producto
model Inventario {
  id           Int      @id @default(autoincrement())
  stock        Int

  sucursalId   Int
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id])

  productoId   Int
  producto     Producto @relation(fields: [productoId], references: [idProducto])

  // Esto es para que no se cargue el mismo producto en una misma sucursal
  @@unique([sucursalId, productoId])
}

model Reserva {
  idMesa             Int
  fechaHoraReservada DateTime
  cantComensales     Int
  estadoReserva      String
  dni                String

  mesa               Mesa     @relation(fields: [idMesa], references: [idMesa])

  // La clave primaria es la clave foránea de Mesa + la fecha y hora
  @@id([idMesa, fechaHoraReservada])
}

enum EstadoMesa {
  Libre
  Ocupada
  Reservada
}

model Mesa {
  idMesa        Int        @id @default(autoincrement())
  numero        Int        
  fila          Int        
  columna       Int
  estado        EstadoMesa
  maxComensales Int

  sucursalId    Int
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id])

  reservas      Reserva[]
  pedidos       Pedido[]

  @@unique([sucursalId, numero])
  @@unique([sucursalId, fila, columna])
}

model Cliente {
  id           Int        @id @default(autoincrement())
  tipo         String
  descuento    Int

  // Para relacionar Cliente y Pedido
  pedidos      Pedido[]
}

enum MetodoPago {
  Efectivo
  Tarjeta
  Transferencia
  MercadoPago
}

// Un pago pertenece a un único pedido: su PK es la FK hacia Pedido (relación 0..1)
model Pago {
  idPedido      Int        @id
  fechaHora     DateTime
  precio        Float
  tipoDescuento String
  metodoPago    MetodoPago
  precioFinal   Float

  pedido        Pedido     @relation(fields: [idPedido], references: [idPedido])
}

// Los roles posibles del sistema. Cada TipoEmpleado tiene exactamente uno
enum Rol {
  DUENIO
  GERENTE
  MOZO
  AYUDANTE_COCINA
}

// Tabla precargada por el seed: una fila por rol
model TipoEmpleado {
  idTipoEmpleado Int     @id @default(autoincrement())
  rol            Rol     @unique
  sueldo         Float

  // Un TipoEmpleado puede tener varios Usuarios (uno por sucursal)
  usuarios       Usuario[]

  // Para relacionar Sucursal y TipoEmpleado
  sucursales     SucursalTipoEmpleado[]
}

// La relación entre Sucursal y TipoEmpleado: cuántos empleados de ese tipo hay en esa sucursal
model SucursalTipoEmpleado {
  cantidad       Int

  sucursalId     Int
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  tipoEmpleadoId Int
  tipoEmpleado   TipoEmpleado @relation(fields: [tipoEmpleadoId], references: [idTipoEmpleado], onDelete: Cascade)

  // Un mismo tipo de empleado aparece una sola vez por sucursal
  @@id([sucursalId, tipoEmpleadoId])
}

// Un gasto pertenece siempre a una sucursal (CRUD dependiente de Sucursal)
model Gasto {
  id         Int      @id @default(autoincrement())
  fechaGasto DateTime @db.Date
  nombre     String
  costo      Float

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
}

model Pedido {
  idPedido      Int            @id @default(autoincrement())
  estadoPedido  String
  comensales    Int

  mesaId        Int
  mesa          Mesa           @relation(fields: [mesaId], references: [idMesa])

  clienteId     Int
  cliente       Cliente        @relation(fields: [clienteId], references: [id])

  sucursalId    Int
  sucursal      Sucursal       @relation(fields: [sucursalId], references: [id])
  mercadoPagoOrderId       String? @unique
  mercadoPagoQrData        String? @db.Text
  mercadoPagoPrecio        Float?
  mercadoPagoTipoDescuento String?
  mercadoPagoPrecioFinal   Float?

  // Un pedido tiene como máximo un pago (0..1)
  pago          Pago?

  // Los productos del pedido
  items         ItemProducto[]
}

// La relación entre Pedido y Producto: cantidad y subTotal (calculado por el service)
model ItemProducto {
  idItemProducto Int      @id @default(autoincrement())
  cantidad       Int
  subTotal       Float

  pedidoId       Int
  pedido         Pedido   @relation(fields: [pedidoId], references: [idPedido], onDelete: Cascade)

  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [idProducto])

  // Un mismo producto aparece una sola vez por pedido
  @@unique([pedidoId, productoId])
}

// Cada sucursal tiene una cuenta por rol (compartida por todos los empleados de ese rol).
// sucursalId null = Dueño, que tiene acceso a todas las sucursales.
// Esa regla (solo el Dueño sin sucursal, un solo Dueño) la valida el service
model Usuario {
  idUsuario      Int          @id @default(autoincrement())
  nombreUsuario  String       @unique
  contrasenia    String       // se guarda el hash de bcrypt, nunca el texto plano

  idTipoEmpleado Int
  tipoEmpleado   TipoEmpleado @relation(fields: [idTipoEmpleado], references: [idTipoEmpleado])

  sucursalId     Int?
  sucursal       Sucursal?    @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  // Una sola cuenta por rol en cada sucursal
  @@unique([idTipoEmpleado, sucursalId])
}
